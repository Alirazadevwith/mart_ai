# ---- Application ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="Mart AI"

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mart_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mart_ai
POSTGRES_TEST_DB=mart_ai_test

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- LLM provider (Phase 2) ----
# grok | groq | openai  -> all OpenAI-compatible, one adapter
# gemini               -> separate adapter
LLM_PROVIDER=grok
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
